# ==============================================================================
# FORESIGHT AI — PRODUCTION ENVIRONMENT TEMPLATE (Render / Cloud Backend)
# Safe deployment template with placeholders. Never commit actual secrets.
# ==============================================================================

# Application Environment
ENVIRONMENT=production
PROJECT_NAME="Foresight AI - Network Attack Forecasting Platform"
API_V1_STR=/api/v1
DEBUG=false

# Server Networking
HOST=0.0.0.0
PORT=8000

# Security & Authentication (Required: 32+ char cryptographic secret)
SECRET_KEY=generate-with-openssl-rand-hex-32-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database Configuration (Managed PostgreSQL on Render/RDS/Neon)
DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/foresight_production

# CORS Configuration (Production Frontend Vercel Domain)
BACKEND_CORS_ORIGINS=["https://foresight-ai.vercel.app"]

# ML & Model Registry Configuration
MODEL_ARTIFACTS_DIR=./artifacts
ACTIVE_MODEL_VERSION=v1.0.0-temporal-gbm
CONFORMAL_TARGET_COVERAGE=0.90

# Telemetry & Rate Limiting
MAX_BATCH_FLOW_RECORDS=10000
RATE_LIMIT_PER_MINUTE=300

# Observability & Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
