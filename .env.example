# ==============================================================================
# FORESIGHT AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit real credentials to Git.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
PROJECT_NAME="Foresight AI - Network Attack Forecasting Platform"
API_V1_STR=/api/v1
DEBUG=true

# Server Networking
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Generate a secure 32+ char key: openssl rand -hex 32
SECRET_KEY=change-this-to-a-super-secret-hex-key-minimum-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database Configuration
# Default fallback to local SQLite for frictionless dev; PostgreSQL URL for staging/prod:
# postgresql+asyncpg://foresight_user:foresight_pass@localhost:5432/foresight_db
DATABASE_URL=sqlite+aiosqlite:///./foresight.db

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ML & Inference Engine Paths
MODEL_ARTIFACTS_DIR=./artifacts/models
ACTIVE_MODEL_VERSION=v1.0.0-baseline
FORECAST_HORIZON_MINUTES=15

# Telemetry Ingestion Limits
MAX_BATCH_FLOW_RECORDS=5000
RATE_LIMIT_PER_MINUTE=120

# Logging & Telemetry
LOG_LEVEL=INFO
LOG_FORMAT=json
